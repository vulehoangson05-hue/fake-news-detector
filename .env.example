# Vietnamese Fake News Detection — environment template.
# Copy to .env and fill in values. NEVER commit .env.

# --- Runtime ---
VNFAKE_ENV=local
VNFAKE_LOG_LEVEL=INFO
# Override default config file path
# VNFAKE_CONFIG_PATH=configs/base.yaml

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=vnfake

# --- Hugging Face Hub (gated models) ---
HF_TOKEN=your_hf_token_here
HF_HOME="D:\hf-cache"

# --- Gemini API (Phase 2.5 Query Rewrite — free tier) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Tavily Web Search API (Phase 3 / Brief #4 — free tier 1,000 credits/month) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- VnCoreNLP (path to extracted JAR directory) ---
VNCORENLP_DIR=./vncorenlp
